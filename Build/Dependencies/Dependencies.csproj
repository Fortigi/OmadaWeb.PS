<!--
  Dependency manifest. NOT a buildable project and never compiled.

  OmadaWeb.PS downloads its binaries at runtime instead of restoring them from a package manifest,
  which used to mean GitHub could not see them: no dependency graph, no Dependabot alerts, and no
  notification when a component the module loads turns out to be vulnerable.

  This file exists so it can. Every package listed here is pinned in OmadaWeb.PS/DependencyLock.psd1
  with the SHA-256 the module verifies at download time. Listing them as PackageReference puts them
  in the repository's dependency graph, so a published advisory raises a Dependabot alert and a
  security-update pull request.

  The versions here and in the lock file must agree; Build/Update-DependencyLock.ps1 -Check enforces
  that in PR validation, and -Refresh recomputes the hashes after a bump. So the flow for a Dependabot
  pull request is: Dependabot bumps the version here, the dependency-lock-sync workflow refreshes the
  hash in the lock file, and validation passes.

  Selenium.WebDriver is pinned separately for Windows PowerShell 5.1 in Legacy/, which must not be
  bumped - see the PinReason in the lock file.
-->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net462</TargetFramework>
    <!-- Nothing here is ever built; the file is parsed by Dependabot only. -->
    <EnableDefaultItems>false</EnableDefaultItems>
  </PropertyGroup>

  <ItemGroup>
    <!-- Drives Microsoft Edge for -AuthenticationType Browser on PowerShell 7 (Install-Selenium). -->
    <PackageReference Include="Selenium.WebDriver" Version="4.47.0" />

    <!-- Hosts the embedded sign-in browser for -AuthenticationType WebView2 (Install-WebView2). -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4129.50" />

    <!-- JSON dependency of the Selenium bindings on Windows PowerShell 5.1 (Install-NewtonSoftJson). -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />

    <!--
      System.Text.Json and the closure it needs on .NET Framework (Install-SystemTextJson). Held on
      the 8.x line: System.Text.Json 9 and later drop the net462 target Windows PowerShell 5.1 needs,
      so majors are ignored in .github/dependabot.yml while 8.0.x security patches still come through.
    -->
    <PackageReference Include="System.Text.Json" Version="8.0.6" />
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="8.0.0" />
    <PackageReference Include="System.Text.Encodings.Web" Version="8.0.0" />
    <PackageReference Include="System.Threading.Tasks.Extensions" Version="4.5.4" />
    <PackageReference Include="System.Runtime.CompilerServices.Unsafe" Version="6.0.0" />
    <PackageReference Include="System.Buffers" Version="4.5.1" />
    <PackageReference Include="System.Memory" Version="4.5.5" />
    <PackageReference Include="System.ValueTuple" Version="4.5.0" />

    <!-- Dependency of the netstandard2.0 Selenium bindings on Windows PowerShell 5.1 (Install-SystemRunTime). -->
    <PackageReference Include="System.Runtime" Version="4.3.1" />
  </ItemGroup>

</Project>
